<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: hooks for the PC scripts and the automated tests against the ESP32 simulator -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Key import from the PC over adb (scripts\push-key.cmd): only the shell (DUMP) can send it -->
        <receiver
            android:name=".keys.KeyImportReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.simoneluconi.btcarkey.IMPORT_KEY" />
            </intent-filter>
        </receiver>

        <!-- Only the shell (DUMP) can send it -->
        <receiver
            android:name=".smart.SmartTestReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.simoneluconi.btcarkey.SMART_TEST" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
